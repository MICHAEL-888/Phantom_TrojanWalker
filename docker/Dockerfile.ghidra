# Ghidra Pipe Service Dockerfile
# Based on blacktop/ghidra with Python + pyghidra added
FROM blacktop/ghidra:12 AS base

USER root

# Refactor note: the hardcoded Tsinghua mirror rewrite is now opt-in via
# USE_CN_MIRROR=1. Default (0) keeps the original Ubuntu mirrors for
# portability outside China.
ARG USE_CN_MIRROR=0
RUN if [ "$USE_CN_MIRROR" = "1" ]; then \
        if [ -f /etc/apt/sources.list ]; then \
            sed -i 's|http://ports.ubuntu.com/ubuntu-ports|https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports|g' /etc/apt/sources.list; \
        fi; \
        if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
            sed -i 's|http://ports.ubuntu.com/ubuntu-ports|https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports|g' /etc/apt/sources.list.d/ubuntu.sources; \
        fi; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    gcc \
    g++ \
    make \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Create and activate virtual environment
RUN python3 -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/venv"

# Set Ghidra installation directory for pyghidra
ENV GHIDRA_INSTALL_DIR=/ghidra

# Install Python dependencies
COPY requirements-ghidra.txt /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-ghidra.txt

# Copy application code ensuring correct directory structure for path calculations
COPY module /app/module

# Create data directories
RUN mkdir -p /app/data/uploads /app/data/projects

# Expose ports
EXPOSE 8000
EXPOSE 9000

# Run the FastAPI service and the MCP server under a signal-forwarding wrapper.
COPY docker/start-ghidra.sh /app/start-ghidra.sh
RUN chmod +x /app/start-ghidra.sh
CMD ["/app/start-ghidra.sh"]
